{
  "name": "sorelax-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true tinacms dev -c \"next dev\"",
    "dev:next": "next dev",
    "build": "TINA_PUBLIC_IS_LOCAL=true tinacms build --local --skip-cloud-checks && next build",
    "build:cloud": "tinacms build && next build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tinacms/cli": "^2.2.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "tinacms": "^3.7.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
