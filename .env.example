# Canonical URL of the deployed site — used for metadata, sitemap, OG tags.
# In production set this to https://sorelaxmassage.be
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— TinaCMS ———
# Provision a project at https://app.tina.io (free tier). Both values come from
# the Tina Cloud project dashboard. Required for:
#   - Running the hosted /admin against Tina Cloud (production)
#   - Generating the admin bundle at build time with auth
# For local editing (`pnpm dev`), leave empty — Tina's local GraphQL server
# writes straight to the content/ JSON files on disk.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# ——— Cookie consent ———
# The cookie banner is a DIY client-side component. No env vars needed.
# Consent is stored in localStorage under `sorelax-consent`. Privacy and
# cookie policies are hardcoded in /privacy and /cookies. Have the copy
# reviewed by a lawyer before launch.

# ——— Salonized ———
# Widget URLs are now owned by TinaCMS (content/settings/settings.json) and
# editable from /admin. These env vars remain as a dev-time fallback: when the
# CMS field is empty, the site reads from here. Leave empty in production.
NEXT_PUBLIC_SALONIZED_WIDGET_URL=
NEXT_PUBLIC_SALONIZED_GIFTCARD_URL=

# ——— Social ———
# Also owned by TinaCMS (settings → Social media). Env vars act as fallback.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ——— Contact form ———
# HTTPS endpoint the /contact form POSTs to. Accepts JSON
# { name, email, phone?, message, company? }. Leave empty in local dev — the
# form then succeeds silently without sending. In production point this at
# either the deployed Cloudflare Worker in ./worker (preferred) or a Formspree
# form URL.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# The worker itself has its own configuration (set via `wrangler secret put` /
# wrangler vars, NOT on the Next.js build). Listed here for visibility:
#   RESEND_API_KEY       secret — Resend API key
#   CONTACT_FORM_TO      var    — info@sorelaxmassage.be
#   CONTACT_FORM_FROM    var    — "So'Relax <no-reply@sorelaxmassage.be>"
#   ALLOWED_ORIGIN       var    — https://sorelaxmassage.be (comma-sep list)
